// A second Worker, because a static site cannot redirect by host name.
{
  "name": "meh-app-www",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "routes": [{ "pattern": "www.meh-app.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "traces": { "enabled": true }, "issues": { "enabled": true } }
}
